#postgres
DB_HOST=your_db_host
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
SECRET_KEY=your_secret_key
ALGORITHM=ALGORITHM
TOKEN_EXP_TIME=TOKEN_EXP_TIME
TMDB_API_KEY=tmdb_api_key
ENVIRONMENT=development
CORS_ORIGINS=your_ip_address

# Recommendation engine: v1, v2, or v3
RECOMMENDATION_ENGINE=v1
# Legacy V1 precomputed recommendation pool size; V3 uses its own 100-candidate limit.
RECOMMENDATION_POOL_SIZE=500
